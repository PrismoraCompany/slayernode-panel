  "eggs": [
    {
      "id": 1,
      "uuid": "egg-purpur-mc",
      "nest_id": 1,
      "nest_name": "Minecraft",
      "author": "admin@slayernode.xyz",
      "name": "Purpur / Paper Minecraft",
      "description": "High performance fork with Folia/Aikar flags and JLine ANSI terminal support.",
      "docker_images": {
        "Java 21 (Default)": "ghcr.io/slayernode/yolks:java_21",
        "Java 17 (Legacy)": "ghcr.io/slayernode/yolks:java_17"
      },
      "startup": "java -Xms128M -XX:MaxRAMPercentage=95.0 -Dterminal.jline=false -Dterminal.ansi=true -jar {{SERVER_JARFILE}}",
      "config": {
        "files": {
          "server.properties": {
            "parser": "properties",
            "find": {
              "server-ip": "0.0.0.0",
              "server-port": "{{server.build.default.port}}"
            }
          }
        },
        "startup": {
          "done": ")! For help, type "
        },
        "stop": "stop"
      },
      "variables": [
        {
          "name": "Server Jar File",
          "description": "Executable jar",
          "env_variable": "SERVER_JARFILE",
          "default_value": "purpur.jar",
          "server_value": "purpur-1.21.4.jar",
          "is_editable": true,
          "rules": "required|string"
        },
        {
          "name": "Build Number",
          "description": "Purpur build version",
          "env_variable": "BUILD_NUMBER",
          "default_value": "latest",
          "server_value": "latest",
          "is_editable": true,
          "rules": "required|string"
        }
      ]
    },
    {
      "id": 2,
      "uuid": "egg-velocity-proxy",
      "nest_id": 1,
      "nest_name": "Minecraft",
      "author": "admin@slayernode.xyz",
      "name": "Velocity Proxy",
      "description": "Next-generation Minecraft proxy with high packet throughput and modern DDoS mitigations.",
      "docker_images": {
        "Java 21": "ghcr.io/slayernode/yolks:java_21"
      },
      "startup": "java -Xms512M -Xmx{{SERVER_MEMORY}}M -XX:+UseG1GC -jar {{SERVER_JARFILE}}",
      "config": {
        "files": {},
        "startup": {
          "done": "Booting Velocity"
        },
        "stop": "end"
      },
      "variables": [
        {
          "name": "Server Jar File",
          "description": "Velocity Jar",
          "env_variable": "SERVER_JARFILE",
          "default_value": "velocity.jar",
          "server_value": "velocity.jar",
          "is_editable": true,
          "rules": "required|string"
        }
      ]
    },
    {
      "id": 3,
      "uuid": "egg-rust-dedicated",
      "nest_id": 2,
      "nest_name": "Steam Dedicated Games",
      "author": "admin@slayernode.xyz",
      "name": "Rust Dedicated",
      "description": "Facepunch Rust experimental survival multi-threaded server instance.",
      "docker_images": {
        "Rust Yolks": "ghcr.io/slayernode/games:rust"
      },
      "startup": "./RustDedicated -batchmode +server.port {{SERVER_PORT}} +server.level \"Procedural Map\" +server.seed {{MAP_SEED}} +server.worldsize {{WORLD_SIZE}} +server.maxplayers {{MAX_PLAYERS}}",
      "config": {
        "files": {},
        "startup": {
          "done": "Server startup complete"
        },
        "stop": "quit"
      },
      "variables": [
        {
          "name": "Map Seed",
          "description": "Procedural map seed",
          "env_variable": "MAP_SEED",
          "default_value": "1337",
          "server_value": "1337",
          "is_editable": true,
          "rules": "numeric"
        },
        {
          "name": "World Size",
          "description": "World map size in meters",
          "env_variable": "WORLD_SIZE",
          "default_value": "4000",
          "server_value": "4000",
          "is_editable": true,
          "rules": "numeric"
        },
        {
          "name": "Max Players",
